# Required before deployment. Never commit real credentials.
NODE_ENV=production
PORT=10000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-32-plus-random-bytes
APP_BASE_URL=https://your-admin-service.onrender.com

# GitHub classic token/fine-grained token with Actions read/write and Contents read.
GITHUB_TOKEN=
GITHUB_OWNER=rishalaliii
GITHUB_REPO=swarnam4u
# Allow reviewed workflows only. Include .github/workflows/build-shorts.yml to enable Shorts controls. Leave empty to disable dispatch.
GITHUB_ALLOWED_WORKFLOWS=

# Google Cloud OAuth 2.0 Web application. Add /auth/youtube/callback as redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-admin-service.onrender.com/auth/youtube/callback
# Optional if you prefer pre-provisioned tokens. OAuth flow is available in the UI.
YOUTUBE_REFRESH_TOKEN=

# Optional: encrypted token store path. On hosting, use persistent storage if available.
TOKEN_STORE_PATH=./data/youtube-token.enc
TOKEN_ENCRYPTION_KEY=

# cron-job.org API integration; keep this key only in Render's environment.
CRONJOB_API_KEY=
CRONJOB_JOB_ID=
